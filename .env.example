# 서버에서 cp .env.example .env 후 값 채우기 - .env는 git에 올리지 않는다(.gitignore됨)

# DB 비밀번호 (필수) - 생성 예: openssl rand -base64 24
DB_PASSWORD=

# 아래는 비워두면 application.yml prod 프로필의 기본값 사용
# (기본: pages.dev 오리진 허용, 쿠키 none+secure)

# FE 오리진 - 쉼표로 여러 개 가능
#CORS_ORIGINS=https://haedal-online-judge-fe.pages.dev

# HTTPS 프록시를 붙이기 전, http://IP:8080 으로 직접 테스트하는 동안에만 임시 하향
#COOKIE_SAMESITE=lax
#COOKIE_SECURE=false
